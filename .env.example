# Per-user keys for the paper-search skill
# (research-skills-hub/open-paper-skills/paper-search). Paste them under Keys in
# os-ui's Papers panel, or copy this file to .env, which Git ignores, and fill
# in the keys you have. Every key is optional:
# without one, the source still answers within its anonymous limits. Each user
# brings their own key; never commit a real one.

# OpenAlex, also used for bioRxiv. Free key: https://openalex.org/settings/api
# Raises the daily budget from $0.10 to $1 (about 100 to 1,000 searches).
OPENALEX_API_KEY=

# PubMed (NCBI E-utilities). Free key from your NCBI account settings.
# Raises the limit from 3 to 10 requests per second.
NCBI_API_KEY=

# Hugging Face read token: https://huggingface.co/settings/tokens
HF_TOKEN=
